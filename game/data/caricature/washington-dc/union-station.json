      ],
      "text": "Union Station \u2014 vaulted concourse silent beneath the stone arches."
    },
    {
      "at": [
        63,
        63
      ],
      "text": "Columbus Circle \u2014 curved stone forecourt and dry fountain basin."
    },
    {
      "at": [
        43,
        52
      ],
      "text": "West Ticket Annex \u2014 yellowed departure boards still hung on brass hooks."
    },
    {
      "at": [
        82,
        52
      ],
      "text": "Express Parcel Room \u2014 hand trucks parked neat beside the dock."
    },
    {
      "at": [
        46,
        64
      ],
      "text": "West Postal Arcade \u2014 sandstone pillars flanking Columbus Circle."
    },
    {
      "at": [
