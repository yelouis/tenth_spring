      ],
      "text": "Healy Hall \u2014 bell tower clock stopped at half past six."
    },
    {
      "at": [
        15,
        22
      ],
      "text": "West Quad Hall \u2014 old slate roof still keeps out the rain."
    },
    {
      "at": [
        16,
        30
      ],
      "text": "Student Walk \u2014 bicycles leaned against this rail before the evacuation."
    },
    {
      "at": [
        26,
        35
      ],
      "text": "M Street Steps \u2014 seventy-five stone steps linking the ridge to M Street. Watch wet moss."
    },
    {
      "at": [
        36,
        29
      ],
      "text": "Healy Overlook \u2014 brass campus map weathered down to the bronze ribs."
    },
    {
      "at": [
        46,
        17
      ],
      "text": "East College Terrace \u2014 chalk arrow pointing toward Q Street ridge."
    },
    {
      "at": [
        64,
        11
      ],
      "text": "North Heights Walk \u2014 quiet stone wall overlooking the upper gardens."
    },
    {
      "at": [
        76,
        14
      ],
      "text": "P Street Turnoff \u2014 brick stoops swept clean after the last windstorm."
    },
    {
      "at": [
        87,
        18
      ],
      "text": "Q Street Ridge Gate \u2014 trail east across Rock Creek toward Dupont Circle."
    },
    {
      "at": [
