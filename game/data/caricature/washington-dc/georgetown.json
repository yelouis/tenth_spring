  "signs": [
    {
      "at": [
        26,
        25
      ],
      "text": "Healy Hall \u2014 bell tower clock stopped at half past six."
    },
    {
      "at": [
        23,
        29
      ],
      "text": "West Quad Hall \u2014 old slate roof still keeps out the rain."
    },
    {
      "at": [
        17,
        29
      ],
      "text": "Student Walk \u2014 bicycles leaned against this rail before the evacuation."
    },
    {
      "at": [
        27,
        35
      ],
      "text": "M Street Steps \u2014 seventy-five stone steps linking the ridge to M Street. Watch wet moss."
    },
    {
      "at": [
        35,
        28
      ],
      "text": "Healy Overlook \u2014 brass campus map weathered down to the bronze ribs."
    },
    {
      "at": [
        48,
        17
      ],
      "text": "East College Terrace \u2014 chalk arrow pointing toward Q Street ridge."
    },
    {
      "at": [
        65,
        16
      ],
      "text": "North Heights Walk \u2014 quiet stone wall overlooking the upper gardens."
    },
    {
      "at": [
        65,
        20
      ],
      "text": "P Street Turnoff \u2014 brick stoops swept clean after the last windstorm."
    },
    {
      "at": [
        91,
        17
      ],
      "text": "Q Street Ridge Gate \u2014 trail east across Rock Creek toward Dupont Circle."
    },
    {
      "at": [
        103,
        17
      ],
      "text": "East Q Boundary \u2014 wagon ruts still hold rainwater after thunder."
    },
    {
      "at": [
        64,
        24
      ],
      "text": "35th & P Lane \u2014 laundry lines still strung between the upper brick bays."
    },
    {
      "at": [
        77,
        25
      ],
      "text": "Upper Terrace Wall \u2014 mortar patched with lime from the old kiln."
    },
    {
      "at": [
        95,
        25
      ],
      "text": "East Ridge Landing \u2014 stacked slate shingles sheltered under the eaves."
    },
    {
      "at": [
        49,
        34
      ],
      "text": "34th Terrace Landing \u2014 iron railings wiped clean of vine tendril shoots."
    },
    {
      "at": [
        65,
        34
      ],
      "text": "Terrace Courtyard \u2014 brass sundial green on its limestone plinth."
    },
    {
      "at": [
        90,
        39
      ],
      "text": "Upper Alley \u2014 cracked brick steps descending behind the north rowhouses."
    },
    {
      "at": [
        44,
        44
      ],
      "text": "Hardware Shop Step \u2014 spare nails and hinges tallied on the doorframe slate."
    },
    {
      "at": [
        19,
        44
      ],
      "text": "West M Street \u2014 rowhouses shuttered, brass knockers green with tarnish."
    },
    {
      "at": [
        33,
        44
      ],
      "text": "Georgetown Shopfront Row \u2014 antiques and used books still sorted inside."
    },
    {
      "at": [
