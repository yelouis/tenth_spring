      "text": "Dupont Circle"
    },
    {
      "at": [
        63,
        75
      ],
      "text": "Dupont Waypost Square \u2014 fountain ring & eight radiating avenues."
    },
    {
      "at": [
        43,
        62
      ],
      "text": "West Ring Road \u2014 Q Street leads west across Rock Creek to Georgetown."
