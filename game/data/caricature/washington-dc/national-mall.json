  "signs": [
    {
      "at": [
        34,
        59
      ],
      "text": "Washington Monument \u2014 marble obelisk rising on the west Mall knoll."
    },
    {
      "at": [
        71,
        36
      ],
      "text": "Smithsonian Castle \u2014 red sandstone towers overlooking the central lawn."
    },
    {
      "at": [
        134,
        41
      ],
      "text": "National Air and Space Museum \u2014 hangar doors open to the flight gallery."
    },
    {
      "at": [
        78,
        52
      ],
      "text": "National Mall Waypost \u2014 long elm-lined lawn between twin museum rows."
    },
    {
      "at": [
        46,
        37
      ],
      "text": "Mall Ranger Station \u2014 trail maps for Monument Grounds and Tidal Basin."
    },
    {
      "at": [
        56,
        34
      ],
      "text": "Conservatory Tool Shed \u2014 pruning shears oiled for the Mall elms."
    },
    {
      "at": [
