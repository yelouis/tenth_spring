      ],
      "text": "United States Capitol \u2014 marble steps silent under the white dome."
    },
    {
      "at": [
        98,
        26
      ],
      "text": "Library of Congress \u2014 bronze doors open for Marcus Bell's night rounds."
    },
    {
      "at": [
        71,
        46
      ],
      "text": "Capitol Forecourt \u2014 four fanning avenues descending into the brick rowhouses."
    },
    {
      "at": [
        64,
        22
      ],
      "text": "Constitution Terrace \u2014 stone walk linking the Capitol and Library."
    },
    {
      "at": [
