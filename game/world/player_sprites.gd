class_name PlayerSprites
extends RefCounted

## game/world/player_sprites.gd — 18-Frame Emerald Player Sprites (Brendan & May) + Code-Drawn Fallback
## Contract: Decision 79 (F77); docs/implementation_plan_travel_and_time.md §(c)

const AssetDB := preload("res://rom/asset_db.gd")

static var _rom_tex_cache: Dictionary = {}
static var _atlas_img_cache: Dictionary = {}
static var _fallback_cache: Dictionary = {}

static func clear_cache() -> void:
	_rom_tex_cache.clear()
	_atlas_img_cache.clear()
	_fallback_cache.clear()

static func sprite_key_for_index(sprite_index: int) -> String:
	return "may" if clampi(sprite_index, 0, 1) == 1 else "brendan"

static func display_name_for_index(sprite_index: int) -> String:
	return "May" if clampi(sprite_index, 0, 1) == 1 else "Brendan"

static func normalize_facing(facing: String) -> String:
	var f := facing.strip_edges().to_upper()
	if f in ["S", "N", "W", "E"]:
		return f
	return "S"

static func normalize_mode(mode: String) -> String:
	return "run" if mode.strip_edges().to_lower() == "run" else "walk"

static func normalize_pose(pose: String) -> String:
	var p := pose.strip_edges().to_lower()
	if p in ["stand", "step_l", "step_r"]:
		return p
	return "stand"

static func resolve_texture(
	sprite_index: int,
	facing: String = "S",
	mode: String = "walk",
	pose: String = "stand",
	force_fallback: bool = false,
	cache_dir: String = AssetDB.DEFAULT_CACHE_DIR
) -> Texture2D:
	var key := sprite_key_for_index(sprite_index)
	var dir := normalize_facing(facing)
	var m := normalize_mode(mode)
	var p := normalize_pose(pose)

	if not force_fallback:
		var bundle: Variant = AssetDB.player_sprite_atlas(cache_dir)
		if bundle is Dictionary:
			var bdict: Dictionary = bundle
			var tex: Texture2D = bdict.get("texture", null)
			var info: Dictionary = bdict.get("json", {})
			var players_map: Dictionary = info.get("players", {})
			if tex != null and players_map.has(key):
				var p_entry: Dictionary = players_map[key]
				var mode_map: Dictionary = p_entry.get(m, p_entry.get("walk", {}))
				var dir_map: Dictionary = mode_map.get(dir, mode_map.get("S", {}))
				var rect_arr: Array = dir_map.get(p, dir_map.get("stand", []))
				if rect_arr.size() >= 4:
					var rid_id := tex.get_rid().get_id()
					var ckey := "%s|%s|%s|%s|%s|%d" % [cache_dir, key, m, dir, p, rid_id]
					if _rom_tex_cache.has(ckey):
						return _rom_tex_cache[ckey]
					var atlas_img: Image = _atlas_img_cache.get(rid_id, null)
					if atlas_img == null:
						atlas_img = tex.get_image()
						if atlas_img != null and not atlas_img.is_empty():
							_atlas_img_cache[rid_id] = atlas_img
					if atlas_img != null and not atlas_img.is_empty():
						var reg := Rect2i(int(rect_arr[0]), int(rect_arr[1]), int(rect_arr[2]), int(rect_arr[3]))
						var sub_tex := ImageTexture.create_from_image(atlas_img.get_region(reg))
						_rom_tex_cache[ckey] = sub_tex
						return sub_tex

	return _build_fallback_texture(key, dir, m, p)

static func _build_fallback_image_16(key: String, facing: String, mode: String, pose: String) -> Image:
	# E is generated by exact pixel horizontal mirror of W so E == mirror(W) always holds!
	if facing == "E":
		var w_img := _build_fallback_image_16(key, "W", mode, pose)
		w_img.flip_x()
		return w_img

	var img16 := Image.create(16, 32, false, Image.FORMAT_RGBA8)
	img16.fill(Color(0, 0, 0, 0))

	var is_may := (key == "may")
	var is_run := (mode == "run")
	var outline := Color8(32, 34, 46, 255)
	var skin := Color8(242, 206, 172, 255)
	var hat := Color8(236, 240, 244, 255) if not is_may else Color8(186, 62, 54, 255)
	var band := Color8(72, 168, 92, 255)
	var hair := Color8(62, 48, 42, 255) if not is_may else Color8(136, 92, 62, 255)
	var jacket := Color8(196, 68, 56, 255) if not is_may else Color8(218, 84, 52, 255)
	var pack := Color8(64, 152, 84, 255) if not is_may else Color8(224, 188, 72, 255)
	var pants := Color8(48, 56, 76, 255) if not is_may else Color8(56, 64, 88, 255)
	var shoe := Color8(206, 74, 62, 255) if not is_may else Color8(224, 108, 68, 255)

	var bob_y: int = 1 if (is_run and pose != "stand") else (1 if pose != "stand" else 0)
	if is_run:
		bob_y += 1

	# Head rows (6..15 + bob)
	var hy0: int = 6 + bob_y
	for ry in range(10):
		var y := hy0 + ry
		for x in range(4, 12):
			var edge := (x == 4 or x == 11 or ry == 0 or ry == 9)
			if edge:
				img16.set_pixel(x, y, outline)
			elif ry <= 2:
				img16.set_pixel(x, y, hat)
			elif ry == 3:
				img16.set_pixel(x, y, band)
			elif facing == "N":
				img16.set_pixel(x, y, hair if ry >= 4 else band)
			else:
				if is_may and (x == 5 or x == 10) and ry >= 4:
					img16.set_pixel(x, y, hair)
				else:
					img16.set_pixel(x, y, skin)

	# May headband ears / Brendan hair tuft
	if is_may:
		img16.set_pixel(5, hy0 - 1, band)
		img16.set_pixel(10, hy0 - 1, band)
	else:
		img16.set_pixel(7, hy0 - 1, hat)
		img16.set_pixel(8, hy0 - 1, hat)

	# Eyes
	if facing == "S":
		img16.set_pixel(6, hy0 + 6, outline)
		img16.set_pixel(9, hy0 + 6, outline)
	elif facing == "W":
		img16.set_pixel(6, hy0 + 6, outline)

	# Torso rows (16..24 + bob)
	var ty0: int = hy0 + 10
	var tx_min: int = 4 if facing == "W" else 3
	var tx_max: int = 12 if facing == "W" else 13
	for ry in range(9):
		var y := ty0 + ry
		if y >= 32:
			continue
		for x in range(tx_min, tx_max):
			var edge := (x == tx_min or x == tx_max - 1 or ry == 0 or ry == 8)
			if edge:
				img16.set_pixel(x, y, outline)
			elif facing == "N" and ry >= 2 and ry <= 6 and x >= 5 and x <= 10:
				img16.set_pixel(x, y, pack)
			elif facing == "W" and x >= 9 and ry >= 2 and ry <= 6:
				img16.set_pixel(x, y, pack)
			elif ry >= 6:
				img16.set_pixel(x, y, pants)
			else:
				img16.set_pixel(x, y, jacket)

	# Arm swing cue for step_l / step_r / run
	if facing == "S" or facing == "N":
		if pose == "step_l":
			img16.set_pixel(2, ty0 + 3, outline)
			img16.set_pixel(2, ty0 + 4, jacket)
			img16.set_pixel(13, ty0 + 5, outline)
		elif pose == "step_r":
			img16.set_pixel(13, ty0 + 3, outline)
			img16.set_pixel(13, ty0 + 4, jacket)
			img16.set_pixel(2, ty0 + 5, outline)
		elif is_run:
			img16.set_pixel(2, ty0 + 4, jacket)
			img16.set_pixel(13, ty0 + 4, jacket)

	# Legs & shoes rows (25..30)
	var ly0: int = mini(25 + (1 if is_run else 0), 27)
	var left_cols: Array = [5, 6]
	var right_cols: Array = [9, 10]
	var l_dy := 0
	var r_dy := 0
	if facing == "W":
		if pose == "stand":
			left_cols = [6, 7]
			right_cols = [8, 9]
		elif pose == "step_l":
			left_cols = [4, 5] if not is_run else [3, 4]
			right_cols = [9, 10] if not is_run else [10, 11]
			l_dy = -1 if is_run else 0
		else:
			left_cols = [5, 6]
			right_cols = [10, 11] if not is_run else [11, 12]
			r_dy = -1 if is_run else 0
	else:
		if pose == "step_l":
			l_dy = -2 if is_run else -1
			r_dy = 1
		elif pose == "step_r":
			l_dy = 1
			r_dy = -2 if is_run else -1

	for leg_spec in [[left_cols, l_dy], [right_cols, r_dy]]:
		var cols: Array = leg_spec[0]
		var ldy: int = int(leg_spec[1])
		for ry in range(4):
			var y := clampi(ly0 + ry + ldy, 0, 31)
			var c := shoe if ry >= 2 else pants
			for x in cols:
				if x >= 0 and x < 16:
					img16.set_pixel(x, y, outline if ry == 3 else c)

	return img16

static func _build_fallback_texture(key: String, facing: String, mode: String, pose: String) -> Texture2D:
	var ckey := "%s|%s|%s|%s" % [key, facing, mode, pose]
	if _fallback_cache.has(ckey):
		return _fallback_cache[ckey]
	var img16 := _build_fallback_image_16(key, facing, mode, pose)
	var out := Image.create(32, 64, false, Image.FORMAT_RGBA8)
	for y in range(32):
		for x in range(16):
			var c := img16.get_pixel(x, y)
			var dx := x * 2
			var dy := y * 2
			out.set_pixel(dx, dy, c)
			out.set_pixel(dx + 1, dy, c)
			out.set_pixel(dx, dy + 1, c)
			out.set_pixel(dx + 1, dy + 1, c)
	var tex := ImageTexture.create_from_image(out)
	_fallback_cache[ckey] = tex
	return tex


static func resolve_shadow_texture(
	force_fallback: bool = false,
	cache_dir: String = AssetDB.DEFAULT_CACHE_DIR
) -> Texture2D:
	if not force_fallback:
		var bundle: Variant = AssetDB.field_effects_atlas(cache_dir)
		if bundle is Dictionary:
			var bdict: Dictionary = bundle
			var tex: Texture2D = bdict.get("texture", null)
			var info: Dictionary = bdict.get("json", {})
			var effects: Dictionary = info.get("effects", {})
			if tex != null and effects.has("shadow_medium"):
				var frames: Array = (effects["shadow_medium"] as Dictionary).get("frames", [])
				if not frames.is_empty():
					var rect_arr: Array = frames[0]
					if rect_arr.size() >= 4:
						var rid_id := tex.get_rid().get_id()
						var ckey := "%s|shadow_medium|%d" % [cache_dir, rid_id]
						if _rom_tex_cache.has(ckey):
							return _rom_tex_cache[ckey]
						var atlas_img: Image = _atlas_img_cache.get(rid_id, null)
						if atlas_img == null:
							atlas_img = tex.get_image()
							if atlas_img != null and not atlas_img.is_empty():
								_atlas_img_cache[rid_id] = atlas_img
						if atlas_img != null and not atlas_img.is_empty():
							var reg := Rect2i(int(rect_arr[0]), int(rect_arr[1]), int(rect_arr[2]), int(rect_arr[3]))
							var sub_tex := ImageTexture.create_from_image(atlas_img.get_region(reg))
							_rom_tex_cache[ckey] = sub_tex
							return sub_tex

	return _build_fallback_shadow_texture()


static func resolve_dust_texture(
	frame_idx: int,
	force_fallback: bool = false,
	cache_dir: String = AssetDB.DEFAULT_CACHE_DIR
) -> Texture2D:
	var f_clamped := clampi(frame_idx, 0, 2)
	if not force_fallback:
		var bundle: Variant = AssetDB.field_effects_atlas(cache_dir)
		if bundle is Dictionary:
			var bdict: Dictionary = bundle
			var tex: Texture2D = bdict.get("texture", null)
			var info: Dictionary = bdict.get("json", {})
			var effects: Dictionary = info.get("effects", {})
			if tex != null and effects.has("ground_impact_dust"):
				var frames: Array = (effects["ground_impact_dust"] as Dictionary).get("frames", [])
				if f_clamped < frames.size():
					var rect_arr: Array = frames[f_clamped]
					if rect_arr.size() >= 4:
						var rid_id := tex.get_rid().get_id()
						var ckey := "%s|dust|%d|%d" % [cache_dir, f_clamped, rid_id]
						if _rom_tex_cache.has(ckey):
							return _rom_tex_cache[ckey]
						var atlas_img: Image = _atlas_img_cache.get(rid_id, null)
						if atlas_img == null:
							atlas_img = tex.get_image()
							if atlas_img != null and not atlas_img.is_empty():
								_atlas_img_cache[rid_id] = atlas_img
						if atlas_img != null and not atlas_img.is_empty():
							var reg := Rect2i(int(rect_arr[0]), int(rect_arr[1]), int(rect_arr[2]), int(rect_arr[3]))
							var sub_tex := ImageTexture.create_from_image(atlas_img.get_region(reg))
							_rom_tex_cache[ckey] = sub_tex
							return sub_tex

	return _build_fallback_dust_texture(f_clamped)


static func _scale_16x8_to_32x16(img16: Image) -> ImageTexture:
	var out := Image.create(32, 16, false, Image.FORMAT_RGBA8)
	for y in range(8):
		for x in range(16):
			var c := img16.get_pixel(x, y)
			var dx := x * 2
			var dy := y * 2
			out.set_pixel(dx, dy, c)
			out.set_pixel(dx + 1, dy, c)
			out.set_pixel(dx, dy + 1, c)
			out.set_pixel(dx + 1, dy + 1, c)
	return ImageTexture.create_from_image(out)


static func _build_fallback_shadow_texture() -> Texture2D:
	var ckey := "fb|shadow_medium"
	if _fallback_cache.has(ckey):
		return _fallback_cache[ckey]
	var img16 := Image.create(16, 8, false, Image.FORMAT_RGBA8)
	img16.fill(Color(0, 0, 0, 0))
	var inner := Color8(24, 28, 40, 148)
	var rim := Color8(24, 28, 40, 88)
	for y in range(3, 8):
		for x in range(2, 14):
			var dx := (float(x) - 7.5) / 5.5
			var dy := (float(y) - 5.0) / 2.2
			var r2 := dx * dx + dy * dy
			if r2 <= 0.72:
				img16.set_pixel(x, y, inner)
			elif r2 <= 1.0:
				img16.set_pixel(x, y, rim)
	var tex := _scale_16x8_to_32x16(img16)
	_fallback_cache[ckey] = tex
	return tex


static func _build_fallback_dust_texture(frame_idx: int) -> Texture2D:
	var ckey := "fb|dust|%d" % frame_idx
	if _fallback_cache.has(ckey):
		return _fallback_cache[ckey]
	var img16 := Image.create(16, 8, false, Image.FORMAT_RGBA8)
	img16.fill(Color(0, 0, 0, 0))
	var light := Color8(236, 224, 196, 230)
	var mid := Color8(204, 184, 152, 200)
	if frame_idx == 0:
		for x in [4, 5, 6, 9, 10, 11]:
			img16.set_pixel(x, 4, light)
			img16.set_pixel(x, 5, light)
			img16.set_pixel(x, 6, mid)
		for x in [3, 7, 8, 12]:
			img16.set_pixel(x, 5, mid)
	elif frame_idx == 1:
		for x in [2, 3, 4, 11, 12, 13]:
			img16.set_pixel(x, 3, light)
			img16.set_pixel(x, 4, light)
			img16.set_pixel(x, 5, mid)
		for x in [5, 10]:
			img16.set_pixel(x, 5, mid)
	else:
		for pt in [Vector2i(1, 3), Vector2i(2, 2), Vector2i(3, 4), Vector2i(12, 4), Vector2i(13, 2), Vector2i(14, 3)]:
			img16.set_pixel(pt.x, pt.y, mid)
	var tex := _scale_16x8_to_32x16(img16)
	_fallback_cache[ckey] = tex
	return tex
