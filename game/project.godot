; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but for loadable features such as autoloads, it can be edited.

config_version=5

[application]

config/name="Tenth Spring"
config/description="A Pokémon game in the Diamond/Pearl style set across famous places of a ruined world."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

Config="*res://autoloads/config.gd"
DB="*res://autoloads/db.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=640
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
